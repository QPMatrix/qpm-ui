{
  "name": "qpm-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "fmt": "bun --bun prettier . --check",
    "fmt:write": "bun --bun prettier . --write",
    "lint": "bun --bun oxlint --type-aware -c .oxlintrc.json .",
    "typecheck": "bun --bun tsc --build --pretty false",
    "build": "bun run --filter '@qpmatrix/tokens' build && bun run --filter '@qpmatrix/typescript-config' build && bun run --filter '@qpmatrix/prettier-config' build && bun run --filter '@qpmatrix/oxlint-config' build && bun run --filter '@qpmatrix/query-fetcher' build && bun run --filter '@qpmatrix/ui' build",
    "test": "bun --filter='*' run test",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo *.tsbuildinfo"
  },
  "devDependencies": {
    "@qpmatrix/prettier-config": "workspace:*",
    "@types/bun": "^1.4.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "6.0.3"
  }
}
