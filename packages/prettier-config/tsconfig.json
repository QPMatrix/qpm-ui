{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@qpmatrix/typescript-config/base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": ["*.ts"],
  "exclude": ["dist"]
}
