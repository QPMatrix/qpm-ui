{
  "name": "@qpmatrix/ui",
  "version": "1.1.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QPMatrix/qpm-ui.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles",
    "components.json",
    "registry.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./styles/qpmatrix.css",
    "./components.json": "./components.json",
    "./registry.json": "./registry.json"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@qpmatrix/tokens": "workspace:*",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@qpmatrix/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "bun --bun tsc --build tsconfig.build.json --pretty false",
    "test": "bun test",
    "scaffold": "bun run scripts/scaffold-component.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:open": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:preview": "bun run scripts/preview-storybook.ts",
    "registry:validate": "bun run scripts/validate-registry.ts",
    "registry:build": "bun run scripts/validate-registry.ts --write",
    "registry:create": "bun run scripts/create-registry-item.ts",
    "registry:check": "bun run scripts/check-component.ts",
    "registry:preview": "bun run scripts/preview-registry.ts",
    "a11y:audit": "bun run scripts/audit-a11y.ts",
    "a11y:contrast": "bun run scripts/check-theme-contrast.ts",
    "a11y:contract": "bun run scripts/check-interactive-contract.ts",
    "a11y:browser": "bun run scripts/a11y-browser.ts"
  }
}
